def runInDocker(String image, Closure body) {
  docker.image(image).inside {
    body()
  }
}

pipeline {
  agent any

  environment {
    CI_IMAGE_NAME = "devops-training-python-app-ci:latest"
  }

  stages {

    // =========================================
    // Build CI image
    // =========================================
    stage('Build CI image') {
      steps {
        script {
          docker.build(
            env.CI_IMAGE_NAME,
            "-f devops/ci.Dockerfile ."
          )
          echo "Imagen CI construida: ${env.CI_IMAGE_NAME}"
        }
      }
    }

    // =========================================
    // Lint
    // =========================================
    stage('Lint') {
      steps {
        script {
          runInDocker(env.CI_IMAGE_NAME) {

            // Instalar dependencias necesarias para lint
            sh '''
              python -m pip install --upgrade pip
              pip install -r requirements.txt flake8 mypy black
            '''

            sh 'make lint'
          }
        }
      }
    }

    // =========================================
    // Test
    // =========================================
    stage('Test') {
      steps {
        script {
          runInDocker(env.CI_IMAGE_NAME) {

            sh '''
              python -m pip install --upgrade pip
              pip install -r requirements.txt
            '''

            sh 'pytest -q'
          }
        }
      }
    }
  }
}

